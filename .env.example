# Required for protected session start/stop requests
DEVICE_API_ACCESS_KEY=replace-with-a-long-random-secret

# Genymotion SaaS managed Android provider (server-side only)
# Create API token in Genymotion SaaS; never use a VITE_ prefix.
GENYMOTION_API_TOKEN=
# UUIDs of ready Android recipes from your Genymotion SaaS account.
# A phone-form-factor recipe is recommended for Cloud Phone.
GENYMOTION_PHONE_RECIPE_UUID=
GENYMOTION_EMULATOR_RECIPE_UUID=

# Reserved for future self-hosted Android runtime adapter
SELF_HOSTED_DEVICE_API_URL=
SELF_HOSTED_DEVICE_API_TOKEN=
