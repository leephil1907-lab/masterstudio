# Required to enable protected device session creation/termination
DEVICE_API_ACCESS_KEY=replace-with-a-long-random-secret

# Managed provider adapter (server-side only)
# Base URL must implement the Master Studio device adapter contract in docs/DEVICE_STUDIO.md
MANAGED_DEVICE_API_URL=
MANAGED_DEVICE_API_TOKEN=

# Optional self-hosted bridge, for a later migration
SELF_HOSTED_DEVICE_API_URL=
SELF_HOSTED_DEVICE_API_TOKEN=

# Do not prefix provider tokens with VITE_. They must never be exposed to the browser.
